{
  "request_file": "request.demo.txt",
  "state_file": "state.demo.json",
  "booking_url": "http://127.0.0.1:8765",
  "date_in_request": "2026-10-14",
  "day_offsets": [0, 1, 2, 3],
  "interval_seconds": 5,
  "active_hours": ["00:00", "24:00"],
