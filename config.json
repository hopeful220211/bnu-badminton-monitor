{
  "booking_url": "https://tycg.bnu.edu.cn/www/dd/vue/spa/zhcg#/",

  "date_in_request": "2026-10-14",
  "date_format": "%Y-%m-%d",
  "day_offsets": [0, 1, 2, 3],
  "release_time": "07:30",

  "interval_seconds": 60,
  "active_hours": ["00:00", "24:00"],
  "burst_windows": [
    {"start": "07:28", "end": "07:45", "interval_seconds": 10},
    {"start": "00:00", "end": "06:30", "interval_seconds": 300}
  ],

  "time_range": ["10:00", "22:00"],
  "court_regex": "^羽[1-8]$",
  "streak_min": 2,
  "include_times": [],
  "include_courts": [],
  "notify_first_run": true,
  "failure_alert_after": 5,
  "daily_report_at": "",

  "parser": {
    "ok_when": {"field": "success", "in": [1]},
    "message_field": "message",
    "list_path": "data.sjkcds.*.sjklist.*",
    "free_when": {"field": "ostatus", "in": [0]},
    "fields": {"time": "xsj", "court": "cdmc"}
  },

  "smtp": {
    "host": "smtp.qq.com",
    "port": 465
  }
}
